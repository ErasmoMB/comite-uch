# Copia este archivo a apps/api/.env y completa los valores.
# apps/api/.env NO se sube a Git.

# Base de datos PostgreSQL (en local: usuario y base que creaste)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/comite_uch?schema=public"

# Clave para firmar los tokens de sesión. Genera una nueva con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Puerto de la API
PORT=3000

# Almacenamiento: "local" guarda los archivos en una carpeta del PC/servidor.
# "r2" usa Cloudflare R2 (variables R2_* más abajo).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./almacenamiento

# Correo (Resend). Déjalo vacío hasta tener la clave: el envío de correo no se probará aún.
RESEND_API_KEY=
EMAIL_FROM=

# Asistente de IA (opcional). Si no pones clave, el asistente queda oculto.
IA_PROVEEDOR=claude
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODELO=
